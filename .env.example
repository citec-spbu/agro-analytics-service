APP_TITLE=agro-analytics
APP_VERSION=0.1.0
APP_AUTH_SERVICE_URL=http://auth-service:8080
APP_CLICKHOUSE_HOST=clickhouse
APP_CLICKHOUSE_PORT=8123
APP_CLICKHOUSE_USER=default
# Должен совпадать с CLICKHOUSE_PASSWORD в docker-compose.yml
APP_CLICKHOUSE_PASSWORD=analytics_dev
APP_CLICKHOUSE_DATABASE=agro_marts
APP_SYNC_INTERVAL_SECONDS=15
# CDC (см. docker-compose.cdc.yml + scripts/register-debezium-connector.sh)
APP_CDC_ENABLED=false
APP_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
APP_KAFKA_FIELDS_TOPIC_PREFIX=fields_cdc
APP_KAFKA_CONSUMER_GROUP=analytics-fields-warehouse
APP_FIELDS_SYNC_DEBOUNCE_SECONDS=3
APP_FIELDS_DATABASE_URL=postgresql://postgres:postgres@fields-db:5432/fields
APP_METEO_DATABASE_URL=postgresql://postgres:postgres@meteo-db:5432/meteo
APP_DZZ_DATABASE_URL=postgresql://dzz:dzz@dzz-db:5432/dzz
